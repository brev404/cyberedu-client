# CyberEdu API Configuration
# Copy this file to examples/.env and fill in your values

# Tenant identifier (default: cyberedu)
CYBEREDU_TENANT=cyberedu

# Session cookie from browser (cyberedu_session)
# Get it from browser developer tools:
#   Chrome/Edge: Application tab → Cookies → app.cyber-edu.co → cyberedu_session
#   Firefox: Storage tab → Cookies → app.cyber-edu.co → cyberedu_session
CYBEREDU_SESSION_COOKIE=
